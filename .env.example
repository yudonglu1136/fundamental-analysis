# Frontend auth
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8787
# Local development only. Must be false or omitted in production.
VITE_AUTH_DEV_BYPASS=false

# Backend auth
SUPABASE_URL=
SUPABASE_JWT_SECRET=
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development only. `npm run api:dev` enables this automatically.
API_AUTH_DEV_BYPASS=false
