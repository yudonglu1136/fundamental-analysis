thesisforge.tech {
  redir https://www.thesisforge.tech{uri} permanent
}

www.thesisforge.tech {
  encode zstd gzip

  handle /api/* {
    reverse_proxy http://guru-analysis-api-prod-378477120101.us-east-1.elasticbeanstalk.com {
      header_up -Origin
      header_up Host guru-analysis-api-prod-378477120101.us-east-1.elasticbeanstalk.com
    }
  }

  handle {
    root * /var/snap/caddy/common/www/thesisforge

    header /index.html Cache-Control "no-cache, must-revalidate"
    header /flutter_bootstrap.js Cache-Control "no-cache, must-revalidate"
    header /flutter_service_worker.js Cache-Control "no-cache, must-revalidate"
    header /main.dart.js Cache-Control "no-cache, must-revalidate"
    header /version.json Cache-Control "no-cache, must-revalidate"

    try_files {path} /index.html
    file_server
  }
}

api.thesisforge.tech {
  handle /ontology-health {
    rewrite * /health
    reverse_proxy 127.0.0.1:8791
  }

  @ontology path \
    /api/ontology/* \
    /api/decision/* \
    /api/strategies \
    /api/strategies/* \
    /api/market/* \
    /api/overview \
    /api/graph \
    /api/methodology \
    /api/timeline \
    /api/rankings \
    /api/company/* \
    /api/snapshot

  handle @ontology {
    reverse_proxy 127.0.0.1:8791
  }

  handle {
    reverse_proxy 127.0.0.1:8787
  }
}
