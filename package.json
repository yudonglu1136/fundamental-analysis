{
  "name": "guru-analysis-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1 --port 5174",
    "server": "API_AUTH_DEV_BYPASS=true node server/index.js",
    "hydrate:db": "node server/hydrateDatabase.js",
    "import:youtube-valuations": "node server/importYoutubeEarningsValuations.js",
    "import:sec-quarterly-valuations": "node server/importSecQuarterlyValuations.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^0.468.0",
    "vite": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {}
}
