{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/(index\\.html|refresh\\.html|main\\.dart\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js)$",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/ontology/?$",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/ontology/(index\\.html|app\\.js|styles\\.css)$",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "^/dbmf(?:/.*)?$",
      "dest": "/?view=ontology"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js?path=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
